@model MovieWithCategoryWithCinemaVM2

<div class="container my-3">
    <div class="row mb-3 align-items-center">
        <div class="col-md-12">
            <h2 class="display-6">Create a New Movie</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Movie.Name" class="form-label">Name</label>
                    <input class="form-control" asp-for="Movie.Name">
                    <span asp-validation-for="Movie.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Movie.Description" class="form-label">Description</label>
                    <textarea class="form-control" asp-for="Movie.Description"></textarea>
                    <span asp-validation-for="Movie.Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Movie.Price" class="form-label">Price</label>
                    <input type="number" step="0.01" class="form-control" asp-for="Movie.Price">
                    <span asp-validation-for="Movie.Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFiles" class="form-label">Movie Images</label>
                    <input type="file" class="form-control" asp-for="ImageFiles" multiple>
                    <span asp-validation-for="ImageFiles" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TrailerFile" class="form-label">Trailer</label>
                    <input type="file" class="form-control" asp-for="TrailerFile">
                    <span asp-validation-for="TrailerFile" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Movie.StartDate" class="form-label">Start Date</label>
                    <input type="date" class="form-control" asp-for="Movie.StartDate">
                    <span asp-validation-for="Movie.StartDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Movie.EndDate" class="form-label">End Date</label>
                    <input type="date" class="form-control" asp-for="Movie.EndDate">
                    <span asp-validation-for="Movie.EndDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Movie.MovieStatus" class="form-label">Status</label>
                    <select asp-for="Movie.MovieStatus" class="form-select">
                        <option value="@MovieStatus.Available">Available</option>
                        <option value="@MovieStatus.Upcoming">Upcoming</option>
                        <option value="@MovieStatus.Expired">Expired</option>
                    </select>
                    <span asp-validation-for="Movie.MovieStatus" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Movie.CinemaId" class="form-label">Cinema</label>
                    <select asp-for="Movie.CinemaId" class="form-select">
                        @foreach (var cinema in Model.Cinemas)
                        {
                            <option value="@cinema.Id">@cinema.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Movie.CinemaId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Movie.CategoryId" class="form-label">Category</label>
                    <select asp-for="Movie.CategoryId" class="form-select">
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Movie.CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Actors</label>
                    <select asp-for="SelectedActorIds" class="form-select" multiple>
                        @foreach (var actor in Model.Actors)
                        {
                            <option value="@actor.Id">@actor.FirstName</option>
                        }
                    </select>
                    <span asp-validation-for="SelectedActorIds" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Create</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}